# OpenClaw gateway auth token (clients must present it). Generate a strong value,
# e.g. `openssl rand -hex 32`. Push to the runner with `make push-secret service=openclaw`.
OPENCLAW_GATEWAY_TOKEN=changeme

# Anthropic API key for the Claude API (create one in the Anthropic Console).
# Referenced by openclaw.json as ${ANTHROPIC_API_KEY}. Push with
# `make push-secret service=openclaw`; never commit a real key.
ANTHROPIC_API_KEY=
