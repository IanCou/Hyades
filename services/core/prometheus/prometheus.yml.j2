{#
  Rendered by ansible/playbooks/prometheus.yml from ansible/inventory/hosts.yml.
  This used to be a hand-kept static target list, and it drifted: by 2026-10
  six hosts answering on :9100 (speedtest, searxng, homeassistant,
  kafka, dev, the Pi) were never scraped, and .3.11 was labelled "db-stack".
  Now adding a host to an inventory group below is enough; CI redeploys
  Prometheus on any inventory change.

  Job names (proxmox, core, prod, test) are the pre-template ones, kept so
  Grafana dashboards and existing series keep matching. github-runner lives
  in the `runners` group but has always been scraped under job `core`, so
  `runners` maps there instead of getting a job of its own. `gateways` is new
  (the Pi runs the apt prometheus-node-exporter on :9100).

  Not scraped:
    - `stopped` (child of ci_deploy_skip): guests Proxmox reports as not
      running, filled in at deploy time by scripts/proxmox_power_state.py.
      Left in, they would sit at up == 0 forever and `up` would stop meaning
      "broken". A manual run without that fragment sees `stopped` empty.
    - bastions (jump), legacy_vms, desktop_vms: no node_exporter verified on
      any of them.
  The Pi is in ci_deploy_skip too, but only via `ci_unreachable` (CI can't SSH
  to it); it is running, so it is scraped.

  `instance` stays Prometheus's default (IP:port) so existing selectors keep
  matching; the inventory name goes in a separate `host` label.

  Scrape groups are looked up with groups[...] so a typo or a renamed group
  fails the render instead of silently dropping a tier. Exclusion groups use
  .get() because an empty or absent one just means nothing to exclude.
#}
{% set excluded_hosts = groups.get('stopped', []) + groups.get('bastions', []) + groups.get('legacy_vms', []) + groups.get('desktop_vms', []) %}
{% set scrape_jobs = [
  {'name': 'proxmox', 'groups': ['proxmox_nodes']},
  {'name': 'core', 'groups': ['core', 'runners']},
  {'name': 'prod', 'groups': ['prod']},
  {'name': 'test', 'groups': ['test']},
  {'name': 'gateways', 'groups': ['gateways']},
] %}
{# First job wins if a host is ever in two scrape groups, so nothing is scraped twice. #}
{% set emitted = namespace(hosts=[]) %}
# Generated by ansible/playbooks/prometheus.yml from
# services/core/prometheus/prometheus.yml.j2 and ansible/inventory/hosts.yml.
# Do not edit on the host; the next deploy overwrites it.
# Not scraped (stopped, or no node_exporter): {{ excluded_hosts | unique | sort | join(', ') }}
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
{% for job in scrape_jobs %}
{%   set candidates = namespace(hosts=[]) %}
{%   for group_name in job.groups %}
{%     set candidates.hosts = candidates.hosts + groups[group_name] %}
{%   endfor %}
{%   set job_hosts = namespace(hosts=[]) %}
{%   for host in candidates.hosts | unique | sort %}
{%     if host not in excluded_hosts and host not in emitted.hosts %}
{%       set job_hosts.hosts = job_hosts.hosts + [host] %}
{%       set emitted.hosts = emitted.hosts + [host] %}
{%     endif %}
{%   endfor %}
  - job_name: {{ job.name }}
{%   if job_hosts.hosts %}
    static_configs:
{%     for host in job_hosts.hosts %}
      - targets: ["{{ hostvars[host].ansible_host }}:9100"]
        labels:
          host: "{{ host }}"
{%     endfor %}
{%   else %}
    static_configs: []
{%   endif %}

{% endfor %}
  - job_name: ntfy
    static_configs:
      - targets:
          - "{{ hostvars['ntfy'].ansible_host }}:9998" # ntfy metrics (unauthenticated port)
