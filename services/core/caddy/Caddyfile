{
	email ian@iancoutinho.net
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

# Gate a site block behind Authentik's embedded outpost forward-auth check.
# REQUIRES a Proxy Provider (forward auth, single application) configured in
# Authentik's admin UI for each protected domain first; until that exists,
# `import authentik` below will fail closed and block all access to the site.
# Do not deploy this Caddyfile (ansible-playbook playbooks/caddy.yml) until
# the Authentik-side provider/outpost setup is done for every protected block.
(authentik) {
	forward_auth 10.0.1.11:9000 {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name
		trusted_proxies private_ranges
	}
}

# Proxmox hypervisors: UI uses self-signed cert, so skip verify on upstream
pve1.example.com {
	reverse_proxy https://10.0.0.10:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

pve2.example.com {
	reverse_proxy https://10.0.0.11:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

pve3.example.com {
	reverse_proxy https://10.0.0.12:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# Core services: 10.0.1.x
# Portainer already has its own native Authentik OIDC login configured;
# layering forward_auth on top would intercept requests before that login
# is ever reached. No `import authentik` here; see ADR-pending PR #25 notes.
portainer.example.com {
	reverse_proxy https://10.0.1.12:9443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

adguard.example.com {
	# DoH clients can't do interactive Authentik login, so /dns-query bypasses
	# the forward-auth gate; everything else (the dashboard) stays behind it.
	@dns_query path /dns-query*
	handle @dns_query {
		reverse_proxy 10.0.1.16:80
	}
	handle {
		import authentik
		reverse_proxy 10.0.1.16:80
	}
}

# Public via Cloudflare tunnel: DoH only, gated on a secret path token so
# random internet clients can't use this as an open DNS resolver. Everything
# except the exact /dns-query/{ADGUARD_DOH_TOKEN} path 404s. Configure your
# own devices' DoH provider URL as:
#   https://adguard.example.com/dns-query/{ADGUARD_DOH_TOKEN} (see .env)
http://adguard.example.com {
	@doh_token path /dns-query/{env.ADGUARD_DOH_TOKEN}*
	handle @doh_token {
		reverse_proxy 10.0.1.16:80 {
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		respond 404
	}
}

